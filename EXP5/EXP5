%{
#include <stdio.h>
%}

%%

[a-z] { 
    /* Convert lowercase to uppercase using ASCII math: subtract 32 */
    printf("%c", yytext[0] - 32); 
}

[A-Z] { 
    /* Convert uppercase to lowercase using ASCII math: add 32 */
    printf("%c", yytext[0] + 32); 
}

.|\n { 
    /* Print all other characters (punctuation, numbers, newlines) as they are */
    ECHO; 
}

%%

int yywrap()
{
    return 1;
}

int main()
{
    printf("Enter text (Press Ctrl+D on Linux/Mac or Ctrl+Z on Windows to end):\n");
    yylex();
    return 0;
}
